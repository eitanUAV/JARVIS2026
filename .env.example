# Copy to .env and adjust. .env is gitignored.

# --- Required ---------------------------------------------------------------
# PostgreSQL connection string. Managed platforms (Railway, Render, Neon,
# Supabase) provide this for you.
DATABASE_URL=postgres://postgres:password@localhost:5432/jarvis2026

# --- Security ---------------------------------------------------------------
# Shared secret for write endpoints (POST /api/users, POST /api/upload-property).
# If unset, those endpoints are OPEN and anyone can mint tokens.
# Generate one with: openssl rand -hex 32
API_KEY=

# Comma-separated browser origins allowed to call the API.
# Defaults to http://localhost:8080,http://127.0.0.1:8080 when unset.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Server -----------------------------------------------------------------
# PORT is read first (Railway/Render/Heroku/Fly inject it); SERVER_PORT is the
# local fallback.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# --- Uploads ----------------------------------------------------------------
# Directory for stored media. Must be a persistent volume in production —
# container filesystems are wiped on redeploy.
UPLOAD_DIR=uploads
# Per-file ceiling in MiB.
MAX_FILE_MB=25

# --- Database pool ----------------------------------------------------------
DB_MAX_CONNECTIONS=10

# --- Demo -------------------------------------------------------------------
# Load properties.json on first boot when the properties table is empty.
SEED_DEMO=false

# --- Logging ----------------------------------------------------------------
RUST_LOG=info
